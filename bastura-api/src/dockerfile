# Menggunakan official image Bun yang ringan
FROM oven/bun:latest

# Menentukan folder kerja di dalam container
WORKDIR /app

# Salin file konfigurasi package dan lockfile terlebih dahulu
COPY package.json bun.lock* ./

# Install dependensi (menggunakan flag production atau install biasa)
RUN bun install

# Salin seluruh sisa file kode (termasuk folder src) ke dalam container
COPY . .

# Buka port 3000 (sesuai port default Hono Anda)
EXPOSE 3000

# Perintah untuk menjalankan aplikasi Hono Anda
CMD ["bun", "run", "src/index.ts"]